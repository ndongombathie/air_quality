# ─── API SEN-AIR : copier en .env, ne jamais committer .env ───
DJANGO_DEBUG=0
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.senair.sn
POSTGRES_PASSWORD=
# Hors Docker : DATABASE_URL=postgres://senair:motdepasse@localhost:5433/senair  (défaut : SQLite)
# DATABASE_URL=

# Clients autorisés (web en développement et en preview) ; le mobile n'est pas concerné par CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
FRONTEND_URL=http://localhost:5173

# ─── Flux de données (pipeline de l'équipe data) ───
# Hôte : localhost:9092. Conteneur relié au réseau du pipeline : kafka:9093. Kafka local du profil « kafka » : kafka:9094.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=senair-api
TOPIC_MEASUREMENTS_RAW=air-quality
TOPIC_MEASUREMENTS=senair.measurements.v1
TOPIC_FORECASTS=senair.forecasts.v1
TOPIC_MODELS=senair.models.v1
TOPIC_INTERPOLATIONS=senair.interpolations.v1
TOPIC_DEAD_LETTER=senair.dead-letter.v1

# ─── Calcul IQA : valeur limite de chaque sous-indice (décision d'équipe, voir docs/13-backend.md) ───
AQI_LIMIT_PM25=15
AQI_LIMIT_PM10=45

# Modèle d'interpolation de l'équipe IA (fichier joblib) ; vide = repli IDW.
# MODEL_INTERPOLATION_PATH=/models/knn_model.pkl

# Notifications push (Expo) et e-mails.
PUSH_ENABLED=1
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=SEN-AIR <no-reply@senair.sn>
