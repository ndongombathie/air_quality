# Configuration publique de l'application mobile SEN-AIR.
# ATTENTION : toute variable EXPO_PUBLIC_* est intégrée en clair dans le bundle de l'application.
# N'y placez JAMAIS de secret (clé d'API privée, mot de passe, jeton…).

# "mock" (données de démonstration, par défaut) ou "rest" (backend Django)
EXPO_PUBLIC_API_MODE=mock

# URL de l'API REST v1. Vide en développement : IP de l'ordinateur qui sert Expo, port 8000 (détection automatique).
# EXPO_PUBLIC_API_BASE_URL=https://api.senair.sn/api/v1

# (Optionnel) identifiant du projet EAS, nécessaire pour obtenir un jeton de notification push Expo.
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Développement (mode mock uniquement) : 1 = ajoute des photos et une vidéo publiques aux articles de démo.
# EXPO_PUBLIC_DEMO_MEDIA=1
