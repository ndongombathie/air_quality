{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senair.sn/schemas/measurement.v1.json",
  "title": "Mesure SEN-AIR v1 (topic senair.measurements.v1)",
  "description": "Mesure validée et enrichie publiée par le pipeline de l'équipe data. Une mesure = une station à un horodatage capteur. Clés JSON en camelCase, dates ISO-8601 UTC, valeur absente = null.",
  "type": "object",
  "required": ["schemaVersion", "messageId", "stationId", "observedAt", "measures"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1" },
    "messageId": { "type": "string", "minLength": 8, "maxLength": 80, "description": "Identifiant unique (UUID) : rend la consommation idempotente." },
    "stationId": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Identifiant de la station (location_id AirGradient)." },
    "stationName": { "type": ["string", "null"], "maxLength": 160 },
    "location": {
      "type": ["object", "null"],
      "required": ["latitude", "longitude"],
      "additionalProperties": false,
      "properties": { "latitude": { "type": "number", "minimum": -90, "maximum": 90 }, "longitude": { "type": "number", "minimum": -180, "maximum": 180 } }
    },
    "observedAt": { "type": "string", "format": "date-time", "description": "Horodatage du capteur (jamais l'heure d'insertion)." },
    "status": { "enum": ["measured", "estimated"], "default": "measured" },
    "measures": {
      "type": "object",
      "propertyNames": { "enum": ["pm25", "pm10", "no2", "so2", "co", "o3", "co2", "tvoc", "no", "nh3"] },
      "additionalProperties": { "$ref": "#/$defs/measure" }
    },
    "weather": { "$ref": "#/$defs/weather" },
    "upstreamAqi": { "type": ["number", "null"], "description": "IQA calculé par le pipeline (colonne iqr), conservé pour comparaison." },
    "pipeline": { "type": "object", "description": "Métadonnées libres du pipeline (version, nom du job...)." }
  },
  "$defs": {
    "measure": {
      "type": "object",
      "required": ["value", "unit", "source"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["number", "null"] },
        "unit": { "enum": ["µg/m³", "mg/m³", "ppm", "ppb", "index"] },
        "source": { "enum": ["sensor", "openweathermap", "satellite", "model"] }
      }
    },
    "weather": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "temperatureC": { "type": ["number", "null"] },
        "humidityPct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "windSpeedMs": { "type": ["number", "null"], "minimum": 0 },
        "windDirectionDeg": { "type": ["number", "null"], "minimum": 0, "maximum": 360 },
        "pressureHpa": { "type": ["number", "null"] },
        "precipitationMm": { "type": ["number", "null"], "minimum": 0 },
        "source": { "enum": ["sensor", "openweathermap"] }
      }
    }
  }
}
